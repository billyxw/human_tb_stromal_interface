
import qupath.lib.objects.PathObjects
import qupath.lib.objects.classes.PathClassFactory

// List of cell types for which to calculate immCPI
def cellTypes = ["B cell", "CD4", "CD8", "Endo", "Epi", "Mac", "Neut", "Other"]

// Ensure only the annotations you want to calculate immCPI for are selected in QuPath
def selectedAnnotations = getSelectedObjects().findAll { it.isAnnotation() }

println("Total selected annotations: ${selectedAnnotations.size()}")

selectedAnnotations.each { lesion ->
    // Get all detections within the lesion
    def childDetections = lesion.getChildObjects().findAll { it.isDetection() }
    
    // Skip processing if there are no detections
    if (!childDetections || childDetections.isEmpty()) {
        println("No detections in lesion '${lesion.getName()}', assigning immCPI value of 1 for all cell types.")
        cellTypes.each { cellType ->
            lesion.getMeasurementList().putMeasurement("${cellType} immCPI", 1)
        }
        return
    }

    // Calculate the mean distance for all cells
    double meanDistanceAll = childDetections.collect {
        it.getMeasurementList().getMeasurementValue("Signed distance to annotation lesion µm")
    }.sum() / childDetections.size()

    cellTypes.each { cellType ->
        // Filter the detections by the current cell type
        def cellTypeDetections = childDetections.findAll { it.getPathClass() && it.getPathClass().getName() == cellType }

        // Calculate immCPI for this cell type, set to 1 if no cells of this type are found
        double immCPI = (!cellTypeDetections || cellTypeDetections.isEmpty()) ? 1 : 
            cellTypeDetections.collect {
                it.getMeasurementList().getMeasurementValue("Signed distance to annotation lesion µm")
            }.sum() / cellTypeDetections.size() / meanDistanceAll
        
        println("${cellType} immCPI for lesion '${lesion.getName()}': ${immCPI}")

        // Add the immCPI measurement to the lesion annotation
        lesion.getMeasurementList().putMeasurement("${cellType} immCPI", immCPI)
    }
}

println("immCPI calculations complete for all specified cell types within selected lesions.")
